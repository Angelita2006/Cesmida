{
  "name": "cesmida-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicación de escritorio de Cesmida",
  "author": "Cesmida",
  "main": "main.cjs",
  "scripts": {
    "build:win": "node build-desktop.cjs && electron-builder --win nsis --x64"
  },
  "build": {
    "appId": "com.cesmida.desktop",
    "productName": "Cesmida",
    "artifactName": "Cesmida-Setup-${version}-${arch}.${ext}",
    "directories": {
      "output": "../desktop-release"
    },
    "files": [
      "main.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "stack",
        "to": "stack"
      }
    ],
    "win": {
      "icon": "cesmida.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0"
  }
}
